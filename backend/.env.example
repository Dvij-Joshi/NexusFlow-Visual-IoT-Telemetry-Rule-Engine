# Server
PORT=5000

# MongoDB - Use MongoDB Atlas or local MongoDB 5.0+
# Local: mongodb://localhost:27017/nexusflow
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexusflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nexusflow

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
